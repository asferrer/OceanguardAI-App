    <!-- Page 1 -->
    <string name="onboarding_page1_title">Bienvenue sur\nOceanGuard AI</string>
    <string name="onboarding_page1_desc">Votre compagnon propulsé par l\'IA pour la détection de déchets marins et le suivi de la santé des océans.</string>

    <!-- Page 2 -->
    <string name="onboarding_page2_title">Détecter les Déchets\nMarins</string>
    <string name="onboarding_page2_desc">Pointez votre caméra sur n\'importe quelle scène sous-marine. Notre détecteur IA classe les débris en temps réel avec une précision supérieure à 90 %.</string>

    <!-- Page 3 -->
    <string name="onboarding_page3_title">Analyse\npar l\'IA</string>
    <string name="onboarding_page3_desc">Notre modèle de langage visuel (VLM) fournit une analyse environnementale approfondie, un score de santé et des recommandations concrètes.</string>

    <!-- Page 4 -->
    <string name="onboarding_page4_title">100% Hors ligne\n&amp; Privé</string>
    <string name="onboarding_page4_desc">Tout le traitement s\'effectue sur l\'appareil. Aucune connexion Internet requise. Vos données ne quittent jamais votre téléphone \u2014 idéal pour le travail de terrain à distance.</string>

    <!-- Page 5 -->
    <string name="onboarding_page5_title">Gagnez des\nrécompenses</string>
    <string name="onboarding_page5_desc">Débloquez des badges en scannant avec la caméra ou en temps réel. Les imports par lot ne comptent pas \u2014 partez sur le terrain pour gravir les rangs\u00a0!</string>

    <!-- Page 6 – Contribution à la recherche -->
    <string name="onboarding_contribute_title">Améliorer la Détection</string>
    <string name="onboarding_contribute_body">Optez pour contribuer vos images analysées à la recherche sur le modèle. Seules les données de détection sont partagées \u2014 sans localisation, sans informations personnelles, entièrement facultatif.</string>
    <string name="onboarding_contribute_toggle">Contribuer mes images</string>

