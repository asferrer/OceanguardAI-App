    <string name="tour_results_health_desc">Salute complessiva dell\'ecosistema basata sulla densità dei rifiuti e sul livello di rischio.</string>
    <string name="tour_results_actions_title">Salva &amp; Condividi</string>
    <string name="tour_results_actions_desc">Salva questa analisi nella cronologia o avvia una nuova scansione.</string>

    <!-- Tour Serie -->
    <string name="tour_batch_grid_title">Analisi in Serie</string>
    <string name="tour_batch_grid_desc">Analizza più immagini contemporaneamente. Ogni scheda mostra il suo progresso di analisi.</string>
    <string name="tour_batch_summary_title">Riepilogo</string>
    <string name="tour_batch_summary_desc">Dopo che tutte le immagini sono elaborate, appare una scheda riepilogativa con le statistiche aggregate.</string>

    <!-- Tour Cronologia -->
    <string name="tour_history_search_title">Ricerca</string>
    <string name="tour_history_search_desc">Digita per cercare per tipo di rifiuto, materiale o livello di rischio in tutte le tue analisi.</string>
    <string name="tour_history_media_filter_title">Immagini e Video</string>
    <string name="tour_history_media_filter_desc">Passa tra le analisi di immagini e video usando questi filtri.</string>
    <string name="tour_history_filters_title">Filtri Avanzati</string>
    <string name="tour_history_filters_desc">Filtra per tipo di rifiuto, luogo o intervallo di date. Combina i filtri per trovare esattamente ciò che cerchi.</string>
    <string name="tour_history_card_title">Scheda Analisi</string>
    <string name="tour_history_card_desc">Tocca per i dettagli. Scorri a sinistra per eliminare. Tieni premuto per la selezione multipla.</string>

    <!-- Tour Dettaglio Sessione -->
    <string name="tour_session_detail_image_title">Immagine Annotata</string>
    <string name="tour_session_detail_image_desc">La tua immagine acquisita con i rifiuti rilevati contrassegnati dai riquadri di delimitazione.</string>
    <string name="tour_session_detail_health_title">Valutazione della Salute</string>
    <string name="tour_session_detail_health_desc">Analisi dettagliata del punteggio di salute dell\'ecosistema per questa analisi.</string>
    <string name="tour_session_detail_location_title">Posizione</string>
    <string name="tour_session_detail_location_desc">Coordinate GPS dove è stata acquisita questa immagine. Tocca modifica per correggere.</string>

    <!-- Tour Mappa -->
    <string name="tour_map_view_title">Mappa Rilevamenti</string>
    <string name="tour_map_view_desc">Tutte le tue analisi sulla mappa. I cluster raggruppano rilevamenti vicini — tocca un cluster per dettagli e tendenze della zona.</string>
    <string name="tour_map_heatmap_title">Mappa di Calore</string>
    <string name="tour_map_heatmap_desc">Alterna tra mappa di calore e pin per vedere i pattern di densità dei rifiuti.</string>
    <string name="tour_map_style_title">Stile Mappa</string>
    <string name="tour_map_style_desc">Alterna tra gli stili Positron (chiaro), Scuro e Liberty (terreno).</string>
    <string name="tour_map_filters_title">Filtri Mappa</string>
    <string name="tour_map_filters_desc">Filtra i marcatori per tipo di rifiuto o intervallo di date per concentrarti su dati specifici.</string>
    <string name="tour_map_fit_all_title">Mostra Tutto</string>
    <string name="tour_map_fit_all_desc">Zooma la mappa per mostrare tutti i tuoi marcatori di rilevamento contemporaneamente.</string>

    <!-- Tour Report -->
    <string name="tour_reports_generate_title">Genera Report</string>
    <string name="tour_reports_generate_desc">Genera un rapporto ambientale IA. Si esegue in background — il progresso appare nelle notifiche. Apri i rapporti salvati per condividere o esportare in PDF.</string>
    <string name="tour_reports_language_title">Data e Lingua</string>
    <string name="tour_reports_language_desc">Filtra per intervallo di date e scegli la lingua del rapporto. Supporta 6 lingue.</string>
    <string name="tour_reports_zone_title">Selettore di Zona</string>
    <string name="tour_reports_zone_desc">Seleziona un luogo di osservazione per generare un rapporto ambientale per zona. Le zone vengono rilevate automaticamente dai dati GPS.</string>

    <!-- Tour Impostazioni -->
    <string name="tour_settings_confidence_title">Impostazioni di Rilevamento</string>
    <string name="tour_settings_confidence_desc">Regola la soglia di confidenza, scegli la precisione del modello (FP16/INT8) e attiva la conferma di cattura.</string>
    <string name="tour_settings_deep_analysis_title">Analisi Approfondita</string>
    <string name="tour_settings_deep_analysis_desc">Attiva il motore VLM per analisi ambientali più dettagliate e rapporti generati dall\'IA.</string>
    <string name="tour_settings_theme_title">Modalità Scura</string>
    <string name="tour_settings_theme_desc">Alterna tra tema scuro e chiaro per una migliore visibilità subacquea.</string>
    <string name="tour_settings_language_title">Lingue</string>
    <string name="tour_settings_language_desc">Imposta la lingua dell\'interfaccia e la lingua predefinita per i rapporti generati dall\'IA.</string>
    <string name="tour_settings_data_title">Gestione Dati</string>
    <string name="tour_settings_data_desc">Reimposta tutti i dati per ricominciare — rimuove analisi, voci MarineDex e traguardi.</string>
    <string name="tour_settings_tours_title">Tour Guidati</string>
    <string name="tour_settings_tours_desc">Rivedi i tour guidati in qualsiasi momento per esplorare tutte le funzionalità dell\'app.</string>

    <!-- Tour MarineDex -->
    <string name="tour_marinedex_progress_title">Progresso Collezione</string>
    <string name="tour_marinedex_progress_desc">Tieni traccia di quanti degli 11 tipi di rifiuti hai scoperto.</string>
    <string name="tour_marinedex_grid_title">Tipi di Rifiuti</string>
    <string name="tour_marinedex_grid_desc">Tocca un tipo scoperto per vedere i dettagli, la galleria e la mappa. I tipi bloccati appaiono come sagome.</string>

    <!-- Tour Dettaglio MarineDex -->
    <string name="tour_marinedex_detail_sprite_title">Sprite Rifiuto</string>
    <string name="tour_marinedex_detail_sprite_desc">Lo sprite pixel art di questo tipo di rifiuto. Tocca il cuore per aggiungerlo ai preferiti.</string>
    <string name="tour_marinedex_detail_impact_title">Impatto Ambientale</string>
    <string name="tour_marinedex_detail_impact_desc">Tempo di degradazione, livello di rischio, rischio principale e volume annuale stimato nell\'oceano.</string>
    <string name="tour_marinedex_detail_tabs_title">Galleria &amp; Mappa</string>
    <string name="tour_marinedex_detail_tabs_desc">Cambia scheda per vedere le immagini catturate di questo tipo e le sue posizioni di rilevamento sulla mappa.</string>
    <string name="tour_marinedex_detail_stats_title">Statistiche di Rilevamento</string>
    <string name="tour_marinedex_detail_stats_desc">Monitora quante volte questo tipo è stato rilevato, e quando è stato visto la prima e l\'ultima volta.</string>

    <!-- Tour Traguardi -->
    <string name="tour_achievements_progress_title">Progresso Traguardi</string>
    <string name="tour_achievements_progress_desc">Il tuo completamento complessivo dei traguardi in tutte le categorie.</string>
    <string name="tour_achievements_list_title">Elenco Traguardi</string>
    <string name="tour_achievements_list_desc">Espandi le categorie per vedere i singoli traguardi e i loro requisiti.</string>

