    <!-- Pagina 1 -->
    <string name="onboarding_page1_title">Benvenuto in\nOceanGuard AI</string>
    <string name="onboarding_page1_desc">Il tuo compagno basato sull\'intelligenza artificiale per il rilevamento dei rifiuti marini e il monitoraggio della salute degli oceani.</string>

    <!-- Pagina 2 -->
    <string name="onboarding_page2_title">Rileva i Rifiuti\nMarini</string>
    <string name="onboarding_page2_desc">Punta la fotocamera su qualsiasi scena subacquea. Il nostro rilevatore AI classifica i rifiuti in tempo reale con un\'accuratezza superiore al 90%.</string>

    <!-- Pagina 3 -->
    <string name="onboarding_page3_title">Analisi basata\nsull\'AI</string>
    <string name="onboarding_page3_desc">Il nostro Vision Language Model fornisce un\'analisi ambientale approfondita, un punteggio di salute e raccomandazioni concrete.</string>

    <!-- Pagina 4 -->
    <string name="onboarding_page4_title">100% Offline\ne Privato</string>
    <string name="onboarding_page4_desc">Tutto il processo avviene sul dispositivo. Nessuna connessione internet richiesta. I tuoi dati non lasciano mai il tuo telefono \u2014 perfetto per il lavoro sul campo in zone remote.</string>

    <!-- Pagina 5 -->
    <string name="onboarding_page5_title">Conquista\ni premi</string>
    <string name="onboarding_page5_desc">Sblocca i badge scansionando con la fotocamera o in tempo reale. I caricamenti in batch non contano \u2014 esci sul campo per guadagnare il tuo rango!</string>

    <!-- Pagina 6 – Contributo alla ricerca -->
    <string name="onboarding_contribute_title">Migliorare il Rilevamento</string>
    <string name="onboarding_contribute_body">Scegli di contribuire le tue immagini analizzate alla ricerca sul modello. Vengono condivisi solo i dati di rilevamento \u2014 nessuna posizione, nessuna informazione personale, completamente facoltativo.</string>
    <string name="onboarding_contribute_toggle">Contribuisci le mie immagini</string>

