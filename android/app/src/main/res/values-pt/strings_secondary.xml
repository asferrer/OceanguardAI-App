    <string name="tour_results_actions_desc">Salve esta análise no histórico ou inicie uma nova análise.</string>

    <!-- Tour em lote -->
    <string name="tour_batch_grid_title">Análise em Lote</string>
    <string name="tour_batch_grid_desc">Analise várias imagens de uma vez. Cada cartão mostra o progresso da sua análise.</string>
    <string name="tour_batch_summary_title">Resumo</string>
    <string name="tour_batch_summary_desc">Após todas as imagens serem processadas, um cartão de resumo aparece com estatísticas agregadas.</string>

    <!-- Tour do histórico -->
    <string name="tour_history_search_title">Pesquisa</string>
    <string name="tour_history_search_desc">Digite para pesquisar por tipo de resíduo, material ou nível de risco em todas as suas análises.</string>
    <string name="tour_history_media_filter_title">Imagens e Vídeos</string>
    <string name="tour_history_media_filter_desc">Alterne entre análises de imagens e vídeos usando estes filtros.</string>
    <string name="tour_history_filters_title">Filtros Avançados</string>
    <string name="tour_history_filters_desc">Filtre por tipo de resíduo, local ou intervalo de datas. Combine filtros para encontrar exatamente o que precisa.</string>
    <string name="tour_history_card_title">Cartão de Análise</string>
    <string name="tour_history_card_desc">Toque para ver detalhes. Deslize para a esquerda para eliminar. Toque longo para seleção múltipla.</string>

    <!-- Tour de detalhes da sessão -->
    <string name="tour_session_detail_image_title">Imagem Anotada</string>
    <string name="tour_session_detail_image_desc">Sua imagem capturada com os detritos detectados marcados por caixas delimitadoras.</string>
    <string name="tour_session_detail_health_title">Avaliação de Saúde</string>
    <string name="tour_session_detail_health_desc">Detalhamento da pontuação de saúde do ecossistema para esta análise.</string>
    <string name="tour_session_detail_location_title">Localização</string>
    <string name="tour_session_detail_location_desc">Coordenadas GPS onde esta imagem foi capturada. Toque em editar para corrigir.</string>

    <!-- Tour do mapa -->
    <string name="tour_map_view_title">Mapa de Detecções</string>
    <string name="tour_map_view_desc">Todas as suas análises no mapa. Os clusters agrupam deteções próximas — toque num cluster para ver detalhes e tendências da zona.</string>
    <string name="tour_map_heatmap_title">Mapa de Calor</string>
    <string name="tour_map_heatmap_desc">Alterne entre mapa de calor e pins para ver padrões de densidade de resíduos.</string>
    <string name="tour_map_style_title">Estilo do Mapa</string>
    <string name="tour_map_style_desc">Alterne entre os estilos Positron (claro), Escuro e Liberty (terreno).</string>

    <string name="tour_map_filters_title">Filtros do Mapa</string>
    <string name="tour_map_filters_desc">Filtre os marcadores por tipo de resíduo ou intervalo de datas para focar em dados específicos.</string>
    <string name="tour_map_fit_all_title">Mostrar Tudo</string>
    <string name="tour_map_fit_all_desc">Ajuste o zoom do mapa para ver todos os seus marcadores de deteção de uma vez.</string>

    <!-- Tour de relatórios -->
    <string name="tour_reports_generate_title">Gerar Relatório</string>
    <string name="tour_reports_generate_desc">Gere um relatório ambiental com IA. Executa em segundo plano — o progresso aparece nas notificações. Abra relatórios guardados para partilhar ou exportar como PDF.</string>
    <string name="tour_reports_language_title">Data e Idioma</string>
    <string name="tour_reports_language_desc">Filtre por intervalo de datas e escolha o idioma do relatório. Suporta 6 idiomas.</string>
    <string name="tour_reports_zone_title">Seletor de Zona</string>
    <string name="tour_reports_zone_desc">Selecione um local de observação para gerar um relatório ambiental por zona. As zonas são detetadas automaticamente a partir dos dados GPS.</string>

    <!-- Tour de configurações -->
    <string name="tour_settings_confidence_title">Configurações de Deteção</string>
    <string name="tour_settings_confidence_desc">Ative ou desative a análise profunda com IA e escolha se deseja pré-visualizar as fotos antes da deteção.</string>
    <string name="tour_settings_deep_analysis_title">Análise Profunda</string>
    <string name="tour_settings_deep_analysis_desc">Ative o motor VLM para análises ambientais mais detalhadas e relatórios gerados por IA.</string>
    <string name="tour_settings_theme_title">Modo Escuro</string>
    <string name="tour_settings_theme_desc">Alterne entre tema escuro e claro para melhor visibilidade subaquática.</string>
    <string name="tour_settings_language_title">Idiomas</string>
    <string name="tour_settings_language_desc">Defina o idioma da interface e o idioma padrão para relatórios gerados por IA.</string>
    <string name="tour_settings_data_title">Gestão de Dados</string>
    <string name="tour_settings_data_desc">Redefina todos os dados para começar do zero — remove análises, entradas MarineDex e conquistas.</string>
    <string name="tour_settings_tours_title">Tours Guiados</string>
    <string name="tour_settings_tours_desc">Repita os tours guiados a qualquer momento para rever todas as funcionalidades da app.</string>

    <!-- Tour do MarineDex -->
    <string name="tour_marinedex_progress_title">Progresso da Coleção</string>
    <string name="tour_marinedex_progress_desc">Acompanhe quantos dos 11 tipos de resíduos você já descobriu.</string>
    <string name="tour_marinedex_grid_title">Tipos de Resíduos</string>
    <string name="tour_marinedex_grid_desc">Toque em um tipo descoberto para ver detalhes, galeria e mapa. Tipos bloqueados aparecem como silhuetas.</string>

    <!-- Tour de detalhes do MarineDex -->
    <string name="tour_marinedex_detail_sprite_title">Sprite do Resíduo</string>
    <string name="tour_marinedex_detail_sprite_desc">O sprite pixel art deste tipo de resíduo. Toque no coração para adicionar aos favoritos.</string>
    <string name="tour_marinedex_detail_impact_title">Impacto Ambiental</string>
    <string name="tour_marinedex_detail_impact_desc">Tempo de degradação, nível de risco, risco principal e volume anual estimado no oceano.</string>
    <string name="tour_marinedex_detail_tabs_title">Galeria &amp; Mapa</string>
    <string name="tour_marinedex_detail_tabs_desc">Mude de separador para ver imagens capturadas deste tipo e as suas localizações de deteção no mapa.</string>
    <string name="tour_marinedex_detail_stats_title">Estatísticas de Deteção</string>
    <string name="tour_marinedex_detail_stats_desc">Acompanhe quantas vezes este tipo foi detetado, e quando foi visto pela primeira e última vez.</string>

