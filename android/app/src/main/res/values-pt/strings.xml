    <string name="onboarding_page1_title">Bem-vindo ao\nOceanGuard AI</string>
    <string name="onboarding_page1_desc">Seu companheiro com IA para detecção de detritos marinhos e monitoramento da saúde dos oceanos.</string>

    <!-- Página 2 -->
    <string name="onboarding_page2_title">Detecte Detritos\nMarinhos</string>
    <string name="onboarding_page2_desc">Aponte a câmera para qualquer cena subaquática. Nosso detector de IA classifica resíduos em tempo real com mais de 90% de precisão.</string>

    <!-- Página 3 -->
    <string name="onboarding_page3_title">Análise\npor IA</string>
    <string name="onboarding_page3_desc">Nosso Modelo de Linguagem Visual fornece análise ambiental profunda, pontuação de saúde e recomendações práticas.</string>

    <!-- Página 4 -->
    <string name="onboarding_page4_title">100% Offline\ne Privado</string>
    <string name="onboarding_page4_desc">Todo o processamento acontece no dispositivo. Sem necessidade de internet. Seus dados nunca saem do seu celular \u2014 perfeito para trabalho de campo remoto.</string>

    <!-- Página 5 -->
    <string name="onboarding_page5_title">Conquiste\nrecompensas</string>
    <string name="onboarding_page5_desc">Desbloqueie emblemas escaneando com a câmera ou em tempo real. Uploads em lote não contam \u2014 vá ao campo para ganhar sua classificação!</string>

    <!-- Página 6 – Contribuição à Pesquisa -->
