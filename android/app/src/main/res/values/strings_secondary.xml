    <string name="tour_session_detail_location_title">Location</string>
    <string name="tour_session_detail_location_desc">GPS coordinates where this image was captured. Tap edit to correct.</string>
    <string name="tour_session_detail_edit_title">Location &amp; Date</string>
    <string name="tour_session_detail_edit_desc">Tap the pencil icon next to the date to correct it. Tap the pin icon to edit the GPS location on a map.</string>

    <!-- Map tour -->
    <string name="tour_map_filters_title">Map Filters</string>
    <string name="tour_map_filters_desc">Filter map markers by debris type or date range to focus on specific data.</string>
    <string name="tour_map_view_title">Detection Map</string>
    <string name="tour_map_view_desc">All your analyses plotted on the map. Clusters group nearby detections - tap a cluster to see zone details and trends.</string>
    <string name="tour_map_heatmap_title">Heatmap</string>
    <string name="tour_map_heatmap_desc">Toggle between heatmap and pin views to see debris density patterns.</string>
    <string name="tour_map_fit_all_title">Fit All</string>
    <string name="tour_map_fit_all_desc">Zoom the map to fit all your detection markers in view at once.</string>
    <string name="tour_map_style_title">Map Style</string>
    <string name="tour_map_style_desc">Cycle between Positron (light), Dark, and Liberty (terrain) map styles.</string>

    <!-- Reports tour -->
    <string name="tour_reports_zone_title">Zone Selector</string>
    <string name="tour_reports_zone_desc">Select a survey location to generate a zone-specific environmental report. Zones are auto-detected from GPS data.</string>
    <string name="tour_reports_language_title">Date &amp; Language</string>
    <string name="tour_reports_language_desc">Filter by date range and choose the language for the generated report. Supports 6 languages.</string>
    <string name="tour_reports_generate_title">Generate Report</string>
    <string name="tour_reports_generate_desc">Generate an AI environmental report. Runs in the background - progress appears in notifications. Open saved reports to share or export as PDF.</string>

    <!-- Settings tour -->
    <string name="tour_settings_confidence_title">Detection Settings</string>
    <string name="tour_settings_confidence_desc">Choose whether to preview photos before analysis. Advanced options (confidence threshold, model precision) are available in Developer Mode.</string>
    <string name="tour_settings_deep_analysis_title">Deep Analysis</string>
    <string name="tour_settings_deep_analysis_desc">Enable the VLM deep analysis engine for richer environmental insights and AI-generated reports.</string>
    <string name="tour_settings_language_title">Languages</string>
    <string name="tour_settings_language_desc">Set the app interface language, the default language for AI reports, and the report audience (scientific, NGO, or citizen).</string>
    <string name="tour_settings_theme_title">Dark Mode</string>
    <string name="tour_settings_theme_desc">Switch between dark and light themes for better underwater visibility.</string>
    <string name="tour_settings_data_title">Data Management</string>
    <string name="tour_settings_data_desc">Reset all data to start fresh - removes all analyses, MarineDex entries, and achievements.</string>
    <string name="tour_settings_tours_title">Guided Tours</string>
    <string name="tour_settings_tours_desc">Replay the guided tours at any time to revisit all app features.</string>
    <string name="tour_settings_contribution_title">Research Contribution</string>
    <string name="tour_settings_contribution_desc">Opt in to share your analyzed images with the OceanGuard research team via your own NAS server. No GPS or personal data - only the image and detections.</string>

    <!-- MarineDex tour -->
    <string name="tour_marinedex_progress_title">Collection Progress</string>
    <string name="tour_marinedex_progress_desc">Track how many of the 11 debris types you\'ve discovered.</string>
    <string name="tour_marinedex_grid_title">Debris Types</string>
    <string name="tour_marinedex_grid_desc">Tap a discovered type to see details, gallery, and map. Locked types appear as silhouettes.</string>

    <!-- MarineDex Detail tour -->
    <string name="tour_marinedex_detail_sprite_title">Debris Sprite</string>
    <string name="tour_marinedex_detail_sprite_desc">The pixel art sprite for this debris type. Tap the heart to add it to your favorites.</string>
    <string name="tour_marinedex_detail_stats_title">Detection Stats</string>
    <string name="tour_marinedex_detail_stats_desc">Track how many times this type was detected, plus when it was first and last seen.</string>
    <string name="tour_marinedex_detail_impact_title">Environmental Impact</string>
    <string name="tour_marinedex_detail_impact_desc">Degradation time, risk level score, primary risk, and estimated annual ocean volume for this debris type.</string>
    <string name="tour_marinedex_detail_tabs_title">Gallery &amp; Map</string>
    <string name="tour_marinedex_detail_tabs_desc">Switch tabs to browse captured images of this type and see its detection locations on the map.</string>

