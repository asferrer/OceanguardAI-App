    <string name="health_breakdown_factor_debris_density_tip">Abzug basierend auf der Müllmenge. Max. 30 Pkt. bei 10+ erkannten Elementen.</string>
    <string name="health_breakdown_factor_risk_level_tip">Durchschnittliches Umweltrisiko der gefundenen Materialien. Max. 50 Pkt.</string>
    <string name="health_breakdown_factor_material_variety_tip">Abzug für die Vielfalt gefundener Schadstoffe. Max. 10 Pkt. bei 7+ Typen.</string>

