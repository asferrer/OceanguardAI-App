    <!-- ================================================================== -->

    <!-- Startseiten-Tour -->
    <string name="tour_home_scan_title">Scannen starten</string>
    <string name="tour_home_scan_desc">Verwenden Sie die Kamera zum Erfassen, oder tippen Sie auf « Aus Galerie scannen » um aus Galerie oder Dateien zu wählen. Unterstützt Bilder und Videos - die App erkennt den Typ und verarbeitet jede Datei automatisch.</string>
    <string name="tour_home_model_status_title">KI-Status</string>
    <string name="tour_home_model_status_desc">Zeigt an, ob der Erkennungsmotor und das Tiefenanalyse-Modell geladen und bereit sind.</string>
    <string name="tour_home_stats_title">Ihre Wirkung</string>
    <string name="tour_home_stats_desc">Verfolgen Sie Ihre Analysen, gefundene Abfälle und den durchschnittlichen Ozean-Gesundheitswert.</string>
    <string name="tour_home_marinedex_title">MarineDex</string>
    <string name="tour_home_marinedex_desc">Ihre Sammlung entdeckter Abfalltypen - entdecken Sie alle 11! Tippen Sie für den vollständigen Katalog.</string>

    <!-- Kamera-Tour -->
    <string name="tour_camera_shutter_title">Aufnahme</string>
    <string name="tour_camera_shutter_desc">Tippen Sie, um ein Foto von Meeresmüll aufzunehmen.</string>
    <string name="tour_camera_flash_title">Blitzsteuerung</string>
    <string name="tour_camera_flash_desc">Zwischen Blitz aus, ein und automatisch wechseln.</string>
    <string name="tour_camera_grid_title">Rasterüberlagerung</string>
    <string name="tour_camera_grid_desc">Verwenden Sie das Drittel-Raster, um Ihr Bild zu gestalten.</string>

    <!-- Live-Erkennungs-Tour -->
    <string name="tour_live_detection_viewfinder_title">Echtzeit-Erkennung</string>
    <string name="tour_live_detection_viewfinder_desc">Richten Sie Ihre Kamera auf Meeresmüll - Erkennungen erscheinen als Live-Begrenzungsrahmen.</string>
    <string name="tour_live_detection_fps_title">Leistung</string>
    <string name="tour_live_detection_fps_desc">Zeigt Bilder pro Sekunde und Inferenzlatenz an.</string>
    <string name="tour_live_detection_capture_title">Bild aufnehmen</string>
    <string name="tour_live_detection_capture_desc">Tippen Sie, um die aktuelle Erkennung zur Analyse zu speichern.</string>

    <!-- Ergebnis-Tour -->
    <string name="tour_results_image_title">Erkennungsergebnisse</string>
    <string name="tour_results_image_desc">Ihr Bild mit erkanntem Meeresmüll, der durch Begrenzungsrahmen hervorgehoben wird.</string>
    <string name="tour_results_health_title">Gesundheitswert</string>
    <string name="tour_results_health_desc">Allgemeine Ökosystemgesundheit basierend auf Mülldichte und Risikostufe.</string>
    <string name="tour_results_actions_title">Speichern &amp; Teilen</string>
    <string name="tour_results_actions_desc">Analyse im Verlauf speichern oder neuen Scan starten.</string>

    <!-- Stapel-Tour -->
    <string name="tour_batch_grid_title">Stapelanalyse</string>
    <string name="tour_batch_grid_desc">Mehrere Bilder gleichzeitig analysieren. Jede Karte zeigt den Analysefortschritt.</string>
    <string name="tour_batch_summary_title">Zusammenfassung</string>
    <string name="tour_batch_summary_desc">Nachdem alle Bilder verarbeitet wurden, erscheint eine Zusammenfassungskarte mit aggregierten Statistiken.</string>

    <!-- Verlaufs-Tour -->
    <string name="tour_history_search_title">Suche</string>
    <string name="tour_history_search_desc">Suchen Sie nach Abfalltyp, Material oder Risikostufe in allen Ihren Analysen.</string>
    <string name="tour_history_media_filter_title">Bilder &amp; Videos</string>
    <string name="tour_history_media_filter_desc">Wechseln Sie zwischen Bild- und Videoanalysen mit diesen Filtertabs.</string>
    <string name="tour_history_filters_title">Erweiterte Filter</string>
    <string name="tour_history_filters_desc">Filtern Sie nach Abfalltyp, Ort oder Datumsbereich. Kombinieren Sie Filter, um genau das zu finden, was Sie suchen.</string>
    <string name="tour_history_card_title">Analysekarte</string>
    <string name="tour_history_card_desc">Tippen für Details. Nach links wischen zum Löschen. Lange drücken für Mehrfachauswahl.</string>

    <!-- Sitzungsdetail-Tour -->
    <string name="tour_session_detail_image_title">Annotiertes Bild</string>
    <string name="tour_session_detail_image_desc">Ihr aufgenommenes Bild mit erkanntem Meeresmüll, markiert durch Begrenzungsrahmen.</string>
    <string name="tour_session_detail_health_title">Gesundheitsbewertung</string>
    <string name="tour_session_detail_health_desc">Detaillierte Aufschlüsselung des Ökosystem-Gesundheitswerts für diese Analyse.</string>
    <string name="tour_session_detail_edit_title">Standort und Datum</string>
    <string name="tour_session_detail_edit_desc">Tippen Sie auf das Stift-Symbol neben dem Datum, um es zu korrigieren. Tippen Sie auf das Pin-Symbol, um den GPS-Standort auf der Karte zu bearbeiten.</string>

    <!-- Karten-Tour -->
    <string name="tour_map_view_title">Erkennungskarte</string>
    <string name="tour_map_view_desc">Alle Ihre Analysen auf der Karte. Cluster gruppieren nahe Erkennungen - tippen Sie auf einen Cluster für Zonendetails und Trends.</string>
    <string name="tour_map_heatmap_title">Heatmap</string>
    <string name="tour_map_heatmap_desc">Wechseln Sie zwischen Heatmap und Pin-Ansicht, um Abfalldichte-Muster zu sehen.</string>
    <string name="tour_map_style_title">Kartenstil</string>
    <string name="tour_map_style_desc">Wechseln Sie zwischen Positron (hell), Dunkel und Liberty (Gelände).</string>
    <string name="tour_map_filters_title">Kartenfilter</string>
    <string name="tour_map_filters_desc">Filtern Sie Kartenmarkierungen nach Abfalltyp oder Datumsbereich, um sich auf bestimmte Daten zu konzentrieren.</string>
    <string name="tour_map_fit_all_title">Alles Anzeigen</string>
    <string name="tour_map_fit_all_desc">Zoomen Sie die Karte, um alle Erkennungsmarkierungen auf einmal anzuzeigen.</string>

    <!-- Berichts-Tour -->
    <string name="tour_reports_generate_title">Bericht erstellen</string>
    <string name="tour_reports_generate_desc">Erstellen Sie einen KI-Umweltbericht. Läuft im Hintergrund - Fortschritt erscheint in Benachrichtigungen. Öffnen Sie gespeicherte Berichte zum Teilen oder PDF-Export.</string>
    <string name="tour_reports_language_title">Datum &amp; Sprache</string>
    <string name="tour_reports_language_desc">Filtern Sie nach Datumsbereich und wählen Sie die Berichtssprache. Unterstützt 6 Sprachen.</string>
    <string name="tour_reports_zone_title">Zonenauswahl</string>
    <string name="tour_reports_zone_desc">Wählen Sie einen Beobachtungsort für einen zonenspezifischen Umweltbericht. Zonen werden automatisch aus GPS-Daten erkannt.</string>

    <!-- Einstellungs-Tour -->
    <string name="tour_settings_confidence_title">Erkennungseinstellungen</string>
    <string name="tour_settings_confidence_desc">Wählen Sie, ob Fotos vor der Analyse in der Vorschau angezeigt werden sollen. Erweiterte Optionen (Konfidenzschwelle, Modellgenauigkeit) sind im Entwicklermodus verfügbar.</string>
    <string name="tour_settings_deep_analysis_title">Tiefenanalyse</string>
    <string name="tour_settings_deep_analysis_desc">Aktivieren Sie die VLM-Tiefenanalyse für detailliertere Umweltinformationen und KI-generierte Berichte.</string>
    <string name="tour_settings_theme_title">Dunkelmodus</string>
    <string name="tour_settings_theme_desc">Wechseln Sie zwischen dunklem und hellem Design für bessere Unterwasser-Sichtbarkeit.</string>
    <string name="tour_settings_language_title">Sprachen</string>
    <string name="tour_settings_language_desc">Stellen Sie die App-Sprache, die Standardsprache für KI-Berichte und die Berichtszielgruppe (wissenschaftlich, NGO oder Bürger) ein.</string>
    <string name="tour_settings_data_title">Datenverwaltung</string>
    <string name="tour_settings_data_desc">Setzen Sie alle Daten zurück - entfernt alle Analysen, MarineDex-Einträge und Erfolge.</string>
    <string name="tour_settings_tours_title">Geführte Touren</string>
    <string name="tour_settings_tours_desc">Spielen Sie die geführten Touren jederzeit erneut ab, um alle App-Funktionen zu erkunden.</string>
    <string name="tour_settings_contribution_title">Forschungsbeitrag</string>
    <string name="tour_settings_contribution_desc">Teilen Sie Ihre analysierten Bilder mit dem OceanGuard-Forschungsteam über Ihren eigenen NAS-Server. Keine GPS-Daten oder persönliche Informationen - nur das Bild und die Erkennungen.</string>

    <!-- MarineDex-Tour -->
    <string name="tour_marinedex_progress_title">Sammelfortschritt</string>
    <string name="tour_marinedex_progress_desc">Verfolgen Sie, wie viele der 11 Mülltypen Sie bereits entdeckt haben.</string>
    <string name="tour_marinedex_grid_title">Mülltypen</string>
    <string name="tour_marinedex_grid_desc">Tippen Sie auf einen entdeckten Typ, um Details, Galerie und Karte zu sehen. Gesperrte Typen erscheinen als Silhouetten.</string>

    <!-- MarineDex-Detail-Tour -->
    <string name="tour_marinedex_detail_sprite_title">Müll-Sprite</string>
    <string name="tour_marinedex_detail_sprite_desc">Das Pixel-Art-Sprite dieses Abfalltyps. Tippen Sie auf das Herz, um es zu Favoriten hinzuzufügen.</string>
    <string name="tour_marinedex_detail_impact_title">Umweltauswirkung</string>
    <string name="tour_marinedex_detail_impact_desc">Abbauzeit, Risikostufe, Hauptrisiko und geschätztes jährliches Ozeanvolumen für diesen Abfalltyp.</string>
    <string name="tour_marinedex_detail_tabs_title">Galerie &amp; Karte</string>
    <string name="tour_marinedex_detail_tabs_desc">Wechseln Sie die Tabs, um aufgenommene Bilder dieses Typs und seine Erkennungsorte auf der Karte zu sehen.</string>
    <string name="tour_marinedex_detail_stats_title">Erkennungsstatistiken</string>
    <string name="tour_marinedex_detail_stats_desc">Verfolgen Sie, wie oft dieser Typ erkannt wurde, sowie wann er zuerst und zuletzt gesehen wurde.</string>

    <!-- Errungenschaften-Tour -->
    <string name="tour_achievements_progress_title">Errungenschaftsfortschritt</string>
