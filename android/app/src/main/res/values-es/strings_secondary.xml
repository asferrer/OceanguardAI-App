    <!-- Tour de inicio -->
    <string name="tour_home_scan_title">Iniciar Escaneo</string>
    <string name="tour_home_scan_desc">Usa la cámara para capturar, o pulsa \"Escanear desde Galería\" para elegir desde la Galería o Archivos. Admite imágenes y vídeos - la app detecta el tipo y procesa cada archivo automáticamente.</string>
    <string name="tour_home_model_status_title">Estado de la IA</string>
    <string name="tour_home_model_status_desc">Muestra si el motor de detección y el modelo de análisis profundo están cargados y listos.</string>
    <string name="tour_home_stats_title">Tu Impacto</string>
    <string name="tour_home_stats_desc">Sigue tus análisis totales, residuos encontrados y puntuación media de salud oceánica.</string>
    <string name="tour_home_marinedex_title">MarineDex</string>
    <string name="tour_home_marinedex_desc">Tu colección de tipos de residuos descubiertos - ¡descúbrelos todos! Pulsa para explorar el catálogo completo.</string>

    <!-- Tour de cámara -->
    <string name="tour_camera_shutter_title">Capturar</string>
    <string name="tour_camera_shutter_desc">Toca para tomar una foto de residuos marinos.</string>
    <string name="tour_camera_flash_title">Control del flash</string>
    <string name="tour_camera_flash_desc">Alterna entre flash apagado, encendido y automático.</string>
    <string name="tour_camera_grid_title">Cuadrícula superpuesta</string>
    <string name="tour_camera_grid_desc">Usa la cuadrícula de tercios para encuadrar tu toma.</string>

    <!-- Tour de detección en vivo -->
    <string name="tour_live_detection_viewfinder_title">Detección en tiempo real</string>
    <string name="tour_live_detection_viewfinder_desc">Apunta tu cámara a los residuos - las detecciones aparecen como cuadros delimitadores en vivo.</string>
    <string name="tour_live_detection_fps_title">Rendimiento</string>
    <string name="tour_live_detection_fps_desc">Muestra los fotogramas por segundo y la latencia de inferencia.</string>
    <string name="tour_live_detection_capture_title">Capturar fotograma</string>
    <string name="tour_live_detection_capture_desc">Toca para guardar la detección actual y analizarla.</string>

    <!-- Tour de resultados -->
    <string name="tour_results_image_title">Resultados de detección</string>
    <string name="tour_results_image_desc">Tu imagen con los residuos detectados resaltados por cuadros delimitadores.</string>
    <string name="tour_results_health_title">Puntuación de salud</string>
    <string name="tour_results_health_desc">Salud general del ecosistema basada en la densidad de residuos y el nivel de riesgo.</string>
    <string name="tour_results_actions_title">Guardar &amp; compartir</string>
    <string name="tour_results_actions_desc">Guarda este análisis en el historial o inicia un nuevo escaneo.</string>

    <!-- Tour de lote -->
    <string name="tour_batch_grid_title">Análisis en lote</string>
    <string name="tour_batch_grid_desc">Analiza varias imágenes a la vez. Cada tarjeta muestra su progreso de análisis.</string>
    <string name="tour_batch_summary_title">Resumen</string>
    <string name="tour_batch_summary_desc">Una vez procesadas todas las imágenes, aparece una tarjeta de resumen con estadísticas agregadas.</string>

    <!-- Tour de historial -->
    <string name="tour_history_media_filter_title">Imágenes y Vídeos</string>
    <string name="tour_history_media_filter_desc">Alterna entre análisis de imágenes y vídeos usando estos filtros.</string>
    <string name="tour_history_search_title">Buscar</string>
    <string name="tour_history_search_desc">Escribe para buscar por tipo de residuo, material o nivel de riesgo en todos tus análisis.</string>
    <string name="tour_history_filters_title">Filtros Avanzados</string>
    <string name="tour_history_filters_desc">Filtra por tipo de residuo, ubicación o rango de fechas. Combina filtros para encontrar exactamente lo que necesitas.</string>
    <string name="tour_history_card_title">Tarjeta de Análisis</string>
    <string name="tour_history_card_desc">Pulsa para ver los detalles. Desliza a la izquierda para eliminar. Mantén pulsado para selección múltiple.</string>

    <!-- Tour de detalle de sesión -->
    <string name="tour_session_detail_image_title">Imagen anotada</string>
    <string name="tour_session_detail_image_desc">Tu imagen capturada con los residuos detectados marcados por cuadros delimitadores.</string>
    <string name="tour_session_detail_health_title">Evaluación de salud</string>
    <string name="tour_session_detail_health_desc">Desglose detallado de la puntuación de salud del ecosistema para este análisis.</string>
    <string name="tour_session_detail_location_title">Ubicación</string>
    <string name="tour_session_detail_location_desc">Coordenadas GPS donde se capturó esta imagen. Toca editar para corregirlas.</string>
    <string name="tour_session_detail_edit_title">Ubicación y fecha</string>
    <string name="tour_session_detail_edit_desc">Toca el icono de lápiz junto a la fecha para corregirla. Toca el icono de pin para editar la ubicación GPS en el mapa.</string>

    <!-- Tour de mapa -->
    <string name="tour_map_filters_title">Filtros del Mapa</string>
    <string name="tour_map_filters_desc">Filtra los marcadores por tipo de residuo o rango de fechas para centrarte en datos específicos.</string>
    <string name="tour_map_view_title">Mapa de Detecciones</string>
    <string name="tour_map_view_desc">Todos tus análisis en el mapa. Los clústeres agrupan detecciones cercanas - pulsa uno para ver detalles de zona y tendencias.</string>
    <string name="tour_map_heatmap_title">Mapa de Calor</string>
    <string name="tour_map_heatmap_desc">Alterna entre mapa de calor y pines para ver patrones de densidad de residuos.</string>
    <string name="tour_map_fit_all_title">Ajustar Vista</string>
    <string name="tour_map_fit_all_desc">Ajusta el zoom para ver todos tus marcadores de detección a la vez.</string>
    <string name="tour_map_style_title">Estilo del Mapa</string>
    <string name="tour_map_style_desc">Alterna entre los estilos Positron (claro), Oscuro y Liberty (terreno).</string>

    <!-- Tour de informes -->
    <string name="tour_reports_zone_title">Selector de Zona</string>
    <string name="tour_reports_zone_desc">Selecciona una ubicación para generar un informe ambiental por zona. Las zonas se detectan automáticamente desde los datos GPS.</string>
    <string name="tour_reports_language_title">Fecha e Idioma</string>
    <string name="tour_reports_language_desc">Filtra por rango de fechas y elige el idioma del informe generado. Compatible con 6 idiomas.</string>
    <string name="tour_reports_generate_title">Generar Informe</string>
    <string name="tour_reports_generate_desc">Genera un informe ambiental con IA. Se ejecuta en segundo plano - el progreso aparece en notificaciones. Abre los informes guardados para compartir o exportar como PDF.</string>

    <!-- Tour de configuración -->
    <string name="tour_settings_confidence_title">Configuración de Detección</string>
    <string name="tour_settings_confidence_desc">Elige si previsualizar las fotos antes del análisis. Las opciones avanzadas (umbral de confianza, precisión del modelo) están disponibles en Modo Desarrollador.</string>
    <string name="tour_settings_deep_analysis_title">Análisis Profundo</string>
    <string name="tour_settings_deep_analysis_desc">Activa el motor de análisis profundo VLM para obtener información ambiental más detallada e informes generados por IA.</string>
    <string name="tour_settings_language_title">Idiomas</string>
    <string name="tour_settings_language_desc">Configura el idioma de la interfaz, el idioma de los informes de IA y el público objetivo (científico, ONG o ciudadano).</string>
    <string name="tour_settings_theme_title">Modo Oscuro</string>
    <string name="tour_settings_theme_desc">Alterna entre tema oscuro y claro para mejor visibilidad submarina.</string>
    <string name="tour_settings_data_title">Gestión de Datos</string>
    <string name="tour_settings_data_desc">Reinicia todos los datos para empezar de cero - elimina análisis, entradas de MarineDex y logros.</string>
    <string name="tour_settings_tours_title">Tours Guiados</string>
    <string name="tour_settings_tours_desc">Repite los tours guiados en cualquier momento para revisar las funcionalidades de la app.</string>
    <string name="tour_settings_contribution_title">Contribución a la Investigación</string>
    <string name="tour_settings_contribution_desc">Únete para compartir tus imágenes analizadas con el equipo de OceanGuard mediante tu propio servidor NAS. Sin GPS ni datos personales - solo la imagen y las detecciones.</string>

    <!-- Tour de MarineDex -->
    <string name="tour_marinedex_progress_title">Progreso de la colección</string>
    <string name="tour_marinedex_progress_desc">Sigue cuántos de los 11 tipos de residuos has descubierto.</string>
    <string name="tour_marinedex_grid_title">Tipos de residuos</string>
    <string name="tour_marinedex_grid_desc">Toca un tipo descubierto para ver detalles, galería y mapa. Los tipos bloqueados aparecen como siluetas.</string>

    <!-- Tour de detalle de MarineDex -->
    <string name="tour_marinedex_detail_sprite_title">Sprite del Residuo</string>
    <string name="tour_marinedex_detail_sprite_desc">El sprite pixel art de este tipo de residuo. Pulsa el corazón para añadirlo a favoritos.</string>
    <string name="tour_marinedex_detail_stats_title">Estadísticas de Detección</string>
    <string name="tour_marinedex_detail_stats_desc">Mira cuántas veces se detectó este tipo, y cuándo se vio por primera y última vez.</string>
    <string name="tour_marinedex_detail_impact_title">Impacto Ambiental</string>
    <string name="tour_marinedex_detail_impact_desc">Tiempo de degradación, nivel de riesgo, riesgo principal y volumen anual estimado en el océano para este tipo de residuo.</string>
    <string name="tour_marinedex_detail_tabs_title">Galería &amp; Mapa</string>
    <string name="tour_marinedex_detail_tabs_desc">Cambia de pestaña para ver imágenes capturadas de este tipo y sus ubicaciones de detección en el mapa.</string>

