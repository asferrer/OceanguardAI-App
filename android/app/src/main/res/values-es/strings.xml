    <!-- Página 1 -->
    <string name="onboarding_page1_title">Bienvenido a\nOceanGuard AI</string>
    <string name="onboarding_page1_desc">Tu compañero con IA para detectar residuos marinos y monitorear la salud del océano.</string>

    <!-- Página 2 -->
    <string name="onboarding_page2_title">Detecta residuos\nmarinos</string>
    <string name="onboarding_page2_desc">Apunta tu cámara a cualquier escena submarina. Nuestro detector de IA clasifica los residuos en tiempo real con más del 90% de precisión.</string>

    <!-- Página 3 -->
    <string name="onboarding_page3_title">Análisis\ncon IA</string>
    <string name="onboarding_page3_desc">Nuestro modelo de lenguaje visual proporciona análisis ambiental profundo, puntuación de salud y recomendaciones prácticas.</string>

    <!-- Página 4 -->
    <string name="onboarding_page4_title">100% sin conexión\n&amp; privado</string>
    <string name="onboarding_page4_desc">Todo el procesamiento ocurre en el dispositivo. No requiere internet. Tus datos nunca salen del teléfono \u2014 ideal para trabajo de campo remoto.</string>

    <!-- Página 5 -->
    <string name="onboarding_page5_title">Gana\nlogros</string>
    <string name="onboarding_page5_desc">Desbloquea insignias escaneando con la cámara o en tiempo real. Las subidas en lote no cuentan \u2014 ¡sal al campo a ganar tu rango!</string>

    <!-- Página 6 – Contribución a la Investigación -->
    <string name="onboarding_contribute_title">Ayuda a Mejorar la Detección</string>
    <string name="onboarding_contribute_body">Opta por contribuir tus imágenes analizadas a la investigación del modelo. Solo se comparten datos de detección \u2014 sin ubicación, sin información personal, completamente opcional.</string>
    <string name="onboarding_contribute_toggle">Contribuir mis imágenes</string>

