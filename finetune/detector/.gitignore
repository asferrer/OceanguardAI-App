# Datasets downloaded by dl_*.py scripts — large, regenerated by running the scripts.
datasets/
output/
runs/

# Splits + calibration lists contain absolute paths to the local filesystem;
# regenerate by running build_merged_yaml.py and build_calibration_set.py.
splits/

# Trained / converted model artefacts — large, regenerate by training.
*.pt
*.pth
*.onnx
*.tflite
*.bin
*.tar
*.tar.gz
*.zip
*.npy

# Logs and PIDs from background training jobs.
*.log
*.err
_train*.txt
