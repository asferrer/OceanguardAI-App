# ==============================================================================
# OceanguardAI-App - Android Mobile Application
# ==============================================================================

# Android build artifacts
android/.gradle/
android/.idea/
android/.kotlin/
android/local.properties
android/app/build/
android/app/.cxx/
android/build/
*.hprof

# Gradle wrapper (keep gradle-wrapper.jar if needed)
# android/gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
.vscode/

# Model files (too large for git)
*.tflite
*.onnx
*.pt
*.pth
*.bin
*.task
*.litertlm
*.param
*.gguf
*.safetensors

# Keep small model files in assets if needed
!android/app/src/main/assets/models/*.tflite
!android/app/src/main/assets/models/*.param
!android/app/src/main/assets/models/*.bin

# Python
__pycache__/
*.py[codz]
*.egg-info/
.venv/
venv/
env/

# Signing keys
*.jks
*.keystore
keystore.properties

# Environment & credentials
.env
.env.*
*.token
hf_token.txt
credentials*.json
*.pem
*.p12

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Debug logs
logcat*.txt
*.log

# Compiled native code
android/app/src/main/jniLibs/
*.so

# APK / AAB
*.apk
*.aab

# Docker (not needed for app repo)
docker/
docker-compose*.yml
Dockerfile*

# Screenshots & temp
screenshots/

# Landing page repo (now a git submodule)
# OceanguardAI/

# Local tooling and AI-assistant config (kept out of the public repo)
.claude/
CLAUDE.md
.cursor/
.aider*
.continue/

# Local artifacts that should never reach a public snapshot
*.html
!OceanguardAI/index.html
!docs/submission/*.html
dumpstate-*.zip
graphify-out/
bugreport-*.zip

# Eval set captured images (kept off-repo, distributed as release asset)
docs/submission/eval_set/images/*.jpg
docs/submission/eval_set/images/*.jpeg
docs/submission/eval_set/images/*.png
docs/submission/eval_set/images/*.heic
!docs/submission/eval_set/images/.gitkeep
